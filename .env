# Brand color theme (build-time). "katan" = purple theme; "blue" or unset = legacy blue theme.
VITE_THEME=katan



VITE_API_BASE_URL=http://localhost:3000/api/v1
# VITE_API_BASE_URL=https://www.katan.finexusai.com/backend/api/v1

# VITE_SOCKET_URL=https://www.katan.finexusai.com/backend

# LIVE + Katan PROD profile ID — match in-house-crm-be PROFILE_GUID (CDN widget validates on prod-api).
